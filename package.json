{
  "name": "n8n-nodes-fallax",
  "version": "0.1.0",
  "description": "n8n node for Fallax: trigger workflows on reported phishing, clicks and credential submits, and keep the directory in step with your HR system.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "fallax",
    "phishing",
    "phishing-simulation",
    "security-awareness"
  ],
  "license": "MIT",
  "homepage": "https://fallax.io/integrations/n8n",
  "author": {
    "name": "Fallax",
    "url": "https://fallax.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FallaxIO/n8n-nodes-fallax.git"
  },
  "bugs": "https://github.com/FallaxIO/n8n-nodes-fallax/issues",
  "type": "commonjs",
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "lint": "oxlint && eslint",
    "lintfix": "oxlint --fix && eslint --fix && oxfmt",
    "typecheck": "node node_modules/typescript-7/bin/tsc",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "publint": "publint",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm publint",
    "release": "pnpm build && changeset publish"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FallaxApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Fallax/Fallax.node.js",
      "dist/nodes/Fallax/FallaxTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.5.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "n8n-workflow": "*",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "packageManager": "pnpm@10.15.0"
}
